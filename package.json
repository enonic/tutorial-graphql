{
  "name": "tutorial-graphql",
  "version": "1.0.0-SNAPSHOT",
  "description": "Tutorial GraphQL",
  "license": "Apache-2.0 license",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/enonic/tutorial-graphql"
  },
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:static": "tsc --noEmit -p src/main/resources/static/tsconfig.json",
    "check:types:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "cov": "jest --no-cache --coverage",
    "lint": "eslint --cache",
    "test": "jest --no-cache"
  },
  "dependencies": {
    "@graphiql/react": "0.37.6",
    "@graphiql/toolkit": "0.12.0",
    "graphiql": "^5.2.3",
    "graphql-ws": "^6.0.8",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@enonic-types/core": "^8.0.4",
    "@enonic-types/global": "^8.0.4",
    "@enonic-types/lib-event": "^8.0.4",
    "@enonic-types/lib-portal": "^8.0.4",
    "@enonic-types/lib-static": "^3.0.0",
    "@enonic-types/lib-websocket": "^8.0.4",
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@tsdown/css": "^0.22.14",
    "@types/node": "^26.0.0",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "concurrently": "^10.0.4",
    "eslint": "^10.7.0",
    "glob": "^13.0.6",
    "jest-environment-jsdom": "^30.4.1",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "tsdown": "^0.22.14",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.63.0"
  }
}
