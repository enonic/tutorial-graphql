{
  "name": "tutorial-graphql",
  "version": "1.0.0-SNAPSHOT",
  "description": "Tutorial GraphQL",
  "license": "Apache-2.0 license",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/enonic/tutorial-graphql"
  },
  "scripts": {
    "build": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "cov": "jest --no-cache --coverage",
    "lint": "oxlint src",
    "test": "jest --no-cache"
  },
  "devDependencies": {
    "@enonic-types/core": "^8.0.4",
    "@enonic-types/global": "^8.0.4",
    "@enonic-types/lib-event": "^8.0.4",
    "@enonic-types/lib-sse": "^8.0.4",
    "@swc/core": "^1.15.47",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.0.0",
    "concurrently": "^10.0.4",
    "glob": "^13.0.6",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "oxlint": "^1.79.0",
    "tsdown": "^0.22.14",
    "typescript": "^7.0.2"
  }
}
